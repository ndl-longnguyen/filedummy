# Cloudflare R2 Configuration (S3-compatible)
CLOUDFLARE_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=file-templates

# Vercel KV / Upstash Redis (Optional - falls back to local cache if omitted)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Analytics & Ads
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ADSENSE_ID=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://filedummy.ndlong.site
NEXT_PUBLIC_SITE_NAME=FileDummy
